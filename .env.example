# =============================================================================
# wifi-manager – príklad environment premenných
# Skopíruj do .env a vyplň hodnoty
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Redis (len v produkcii) ───────────────────────────────────────────────────
REDIS_PASSWORD=

# ── OpenLDAP ──────────────────────────────────────────────────────────────────
LDAP_DOMAIN=oratko.local
LDAP_BASE_DN=dc=oratko,dc=local
LDAP_ADMIN_PASSWORD=
LDAP_CONFIG_PASSWORD=
LDAP_READONLY_PASSWORD=

# ── FreeRADIUS ────────────────────────────────────────────────────────────────
# Shared secret musí súhlasiť s UniFi Network → RADIUS klientom
RADIUS_SECRET=
# CoA secret – musí súhlasiť s UniFi: Settings → RADIUS → CoA shared secret
RADIUS_COA_SECRET=

# ── Django ────────────────────────────────────────────────────────────────────
# Vygeneruj: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Fernet key pre šifrovanie ldap_password v DB
# Generuj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Superadmin účet (vytvorí sa automaticky pri prvom docker compose up)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=

# ── Brevo email ───────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
# Odosielacia adresa
MAIL_FROM=
# Brevo SMTP relay – nájdeš na app.brevo.com → SMTP & API → SMTP
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Brevo REST API kľúč – pre scripts/setup-brevo.sh (app.brevo.com → API Keys)
BREVO_API_KEY=

# Email admina – kam chodia notifikácie o expirácii kľúčov
ADMIN_EMAIL=

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_IP=

# ── Doména (len pre produkciu) ────────────────────────────────────────────────
DOMAIN=

# ── Cloudflare DNS-01 (Let's Encrypt v produkcii) ────────────────────────────
# Vytvor API token na dash.cloudflare.com → My Profile → API Tokens
# Permissions: Zone:DNS:Edit, Zone:Zone:Read
CLOUDFLARE_API_TOKEN=

# ── UniFi Network Application ─────────────────────────────────────────────────
UNIFI_MONGO_USER=
UNIFI_MONGO_PASS=

# ── UniFi AP – SSH prístup (pre odpojenie zariadenia cez CoA/deauth) ──────────
AP_SSH_USER=
AP_SSH_PASSWORD=

# ── FreeRADIUS – rozsah IP, z ktorých smú prísť RADIUS requesty ──────────────
# Zúž na IP/podsieť UniFi controllera, nenechávaj otvorené pre všetkých!
RADIUS_CLIENT_NETWORK=

# ── FreeRADIUS Status-Server (interné štatistiky pre monitoring) ─────────────
# Socket počúva len na 127.0.0.1 vnútri kontajnera, von nie je exponovaný.
# Generuj: openssl rand -hex 24
RADIUS_STATUS_SECRET=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=
GRAFANA_PASSWORD=
# Heslo read-only Postgres roly grafana_ro (dashboard "Používatelia")
# Generuj: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
GRAFANA_PG_PASSWORD=

# ── Web Push (PWA notifikácie pre superadmina) ───────────────────────────────
# POVINNÉ – bez nich backend vôbec nenaštartuje (fail-fast v settings.py).
# VAPID pár generuj skriptom:
#   docker compose run --rm backend python3 -c "
#   from cryptography.hazmat.primitives.asymmetric import ec
#   import base64
#   k = ec.generate_private_key(ec.SECP256R1()); p = k.public_key().public_numbers()
#   b = lambda x: base64.urlsafe_b64encode(x).rstrip(b'=').decode()
#   print('VAPID_PRIVATE_KEY=' + b(k.private_numbers().private_value.to_bytes(32,'big')))
#   print('VAPID_PUBLIC_KEY=' + b(b'\x04' + p.x.to_bytes(32,'big') + p.y.to_bytes(32,'big')))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresa v tvare mailto:...  – kontakt pre push službu (Apple/Google)
VAPID_CLAIM_EMAIL=
# Secret pre Grafana → backend webhook. Generuj: openssl rand -hex 24
PUSH_WEBHOOK_SECRET=
